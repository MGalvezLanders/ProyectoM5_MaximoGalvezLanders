# Firebase (front)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Admins (lista de emails separados por coma)
# Los usuarios que se registren con estos emails se promueven a role 'admin'
# automáticamente al loguearse.
VITE_ADMIN_EMAILS=

# AWS S3 (sin prefijo VITE_: solo se leen del lado del server / Vercel Function)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
