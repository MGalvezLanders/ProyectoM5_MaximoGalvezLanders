# Firebase (front)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Admins (lista de emails separados por coma)
# Los usuarios que se registren con estos emails se promueven a role 'admin'
# automáticamente al loguearse.
VITE_ADMIN_EMAILS=

# AWS S3 (sin prefijo VITE_: solo se leen del lado del server / Vercel Function)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Firebase Admin (server-side) — para verificar el ID token en /api/s3-presign.
# Sacar del JSON del service account: Firebase Console → Project settings →
# Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# La private key incluye saltos de línea. Pegar el valor TAL COMO viene del JSON,
# con los \n literales entre comillas dobles. El código los reemplaza por saltos
# reales al inicializar firebase-admin.
# Ejemplo: FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# Lista de emails admin (server-side, sin prefijo VITE_).
# Debe coincidir con VITE_ADMIN_EMAILS — la del cliente protege la UI,
# esta protege /api/s3-presign en el server.
ADMIN_EMAILS=
