# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# AWS S3 (sin prefijo VITE_: se usa en Vercel Functions y en scripts/seed)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Firebase Admin (solo para scripts locales tipo seed)
# Descargar firebase-service-account.json desde:
# Firebase Console → Project Settings → Service accounts → Generate new private key
# Guardarlo en la raíz del proyecto (está en .gitignore)